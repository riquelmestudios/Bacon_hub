    Corner(ibg,6); local ibs = Stroke(ibg,CFG.Purple,1,0.6)

    local box = Instance.new("TextBox",ibg)
    box.Size=UDim2.new(1,-14,1,0); box.Position=UDim2.new(0,8,0,0)
    box.BackgroundTransparency=1; box.Text=""
    box.PlaceholderText="Nome do jogador..."
    box.PlaceholderColor3=Color3.fromRGB(85,72,115)
    box.TextColor3=Color3.fromRGB(220,210,255); box.Font=Enum.Font.GothamMedium
    box.TextSize=12; box.TextXAlignment=Enum.TextXAlignment.Left
    box.ClearTextOnFocus=false; box.ZIndex=7
    box.Focused:Connect(function() TW(ibs,{Transparency=0.15}) end)
    box.FocusLost:Connect(function() TW(ibs,{Transparency=0.6}) end)

    local okbtn = Instance.new("TextButton",c)
    okbtn.Size=UDim2.new(0,58,0,30); okbtn.Position=UDim2.new(1,-70,0,30)
    okbtn.BackgroundColor3=CFG.PurpleDk; okbtn.Text="OK"
    okbtn.TextColor3=Color3.new(1,1,1); okbtn.Font=Enum.Font.GothamBlack
    okbtn.TextSize=13; okbtn.BorderSizePixel=0; okbtn.ZIndex=6
    Corner(okbtn,6)
    okbtn.MouseEnter:Connect(function() TW(okbtn,{BackgroundColor3=CFG.Purple}) end)
    okbtn.MouseLeave:Connect(function() TW(okbtn,{BackgroundColor3=CFG.PurpleDk}) end)

    local function tryFind()
        local n = box.Text
        if n=="" then Notify("❌","Digite o nome do jogador!",2); return end
        local found
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Name:lower()==n:lower() or p.DisplayName:lower()==n:lower() then found=p; break end
        end
        if not found then
            for _,p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():find(n:lower(),1,true) then found=p; break end
            end
        end
        if found then
            lbl.Text = label.." ✅ "..found.Name
            TW(cs,{Color=CFG.Purple,Transparency=0.3})
            onConfirm(found)
        else
            Notify("❌ Não encontrado","'"..n.."' não está no servidor!",3)
            TW(ibs,{Color=Color3.fromRGB(255,55,55)},0.1)
            task.delay(1, function() TW(ibs,{Color=CFG.Purple},0.3) end)
        end
    end
    okbtn.MouseButton1Click:Connect(tryFind)
    box.FocusLost:Connect(function(enter) if enter then tryFind() end end)
    return c
end

-- Nav button factory
local activeNav = nil
local function MakeNav(label, emoji, tab)
    local btn = Instance.new("TextButton",NavScroll)
    btn.Size=UDim2.new(0,178,0,44); btn.BackgroundColor3=CFG.BGItem
    btn.BackgroundTransparency=1; btn.Text=""; btn.ZIndex=5
    Corner(btn,8)

    local em = Instance.new("TextLabel",btn)
    em.Size=UDim2.new(0,28,0,28); em.Position=UDim2.new(0,9,0.5,-14)
    em.BackgroundTransparency=1; em.Text=emoji; em.TextSize=17; em.ZIndex=6

    local lbl = Instance.new("TextLabel",btn)
    lbl.Size=UDim2.new(1,-46,1,0); lbl.Position=UDim2.new(0,42,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=Color3.fromRGB(120,110,155); lbl.Font=Enum.Font.GothamMedium
    lbl.TextSize=13; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=6

    local ind = Instance.new("Frame",btn)
    ind.Size=UDim2.new(0,3,0.58,0); ind.Position=UDim2.new(0,0,0.21,0)
    ind.BackgroundColor3=CFG.Purple; ind.BackgroundTransparency=1
    ind.BorderSizePixel=0; ind.ZIndex=6
    Corner(ind,3)

    local function activate()
        if activeNav and activeNav~=btn then
            -- deactivate previous
            local prev = activeNav
            TW(prev,{BackgroundTransparency=1})
            for _,ch in ipairs(prev:GetChildren()) do
                if ch:IsA("TextLabel") and ch~=em then TW(ch,{TextColor3=Color3.fromRGB(120,110,155)}) end
                if ch:IsA("Frame") then TW(ch,{BackgroundTransparency=1}) end
            end
        end
        TW(btn,{BackgroundTransparency=0,BackgroundColor3=Color3.fromRGB(18,14,32)})
        TW(lbl,{TextColor3=Color3.fromRGB(228,215,255)})
        TW(ind,{BackgroundTransparency=0})
        TabTitle.Text = label:upper()
        for _,t in ipairs(Content:GetChildren()) do if t:IsA("ScrollingFrame") then t.Visible=false end end
        tab.Visible = true
        activeNav = btn
    end

    btn.MouseEnter:Connect(function()
        if activeNav~=btn then TW(btn,{BackgroundTransparency=0.55,BackgroundColor3=Color3.fromRGB(14,10,25)}) end
    end)
    btn.MouseLeave:Connect(function()
        if activeNav~=btn then TW(btn,{BackgroundTransparency=1}) end
    end)
    btn.MouseButton1Click:Connect(activate)
    return btn, activate
end

