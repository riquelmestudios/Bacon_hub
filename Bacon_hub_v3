            State.ChatPollConn = RunService.Heartbeat:Connect(function()
                local now = tick()
                if now-State.ChatLastFetch>=3 then
                    State.ChatLastFetch=now; task.spawn(FetchChat)
                end
            end)
        end
    else
        if State.ChatPollConn then State.ChatPollConn:Disconnect(); State.ChatPollConn=nil end
    end
end)

