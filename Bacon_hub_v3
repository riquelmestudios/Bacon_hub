local function SendChatMsg(text)
    if text=="" then return end
    local uid = Player.UserId
    if State.ChatMutes[uid] and tick()<State.ChatMutes[uid] then
        Notify("🔇 Chat","Você está suspenso por 10 min!",3); return
    end
    local now = tick()
    if State.ChatLastMsg[uid] and (now-State.ChatLastMsg[uid])<2 then
        Notify("⏳ Chat","Aguarde antes de enviar outra mensagem!",2); return
    end
    State.ChatLastMsg[uid] = now
    local clean = text:sub(1,200)
    if hasBadWord(clean) or hasLink(clean) then
        State.ChatMutes[uid] = tick()+600
        Notify("🚫 Chat","Mensagem bloqueada! Suspenso 10 min.",4); return
    end
    local data = {
        Id        = HttpService:GenerateGUID(false),
        UserId    = uid,
        Username  = Player.Name,
        Text      = clean,
        Timestamp = os.time(),
    }
    pcall(function()
        HttpService:PostAsync(CFG.DATABASE..".json",
            HttpService:JSONEncode(data), Enum.HttpContentType.ApplicationJson)
    end)
    RenderMsg(data)
    State.ChatSeenIds[data.Id] = true
end

local function FetchChat()
    pcall(function()
        local raw = HttpService:GetAsync(CFG.DATABASE..".json?orderBy=\"Timestamp\"&limitToLast=25")
        if not raw or raw=="null" then return end
        local ok,decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if not ok or type(decoded)~="table" then return end
        local msgs = {}
        for _,v in pairs(decoded) do
            if type(v)=="table" and v.Id and v.Text then table.insert(msgs,v) end
        end
        table.sort(msgs, function(a,b) return (a.Timestamp or 0)<(b.Timestamp or 0) end)
        for _,m in ipairs(msgs) do
            if not State.ChatSeenIds[m.Id] then
                State.ChatSeenIds[m.Id]=true
                if m.UserId ~= Player.UserId then RenderMsg(m) end
            end
        end
    end)
end

CW:GetPropertyChangedSignal("Visible"):Connect(function()
